# MainAI — Environment Configuration Example
# Copy to .env and replace placeholders with your local or staging PostgreSQL credentials.
# Never commit real credentials or secrets to version control.

DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/app_db"

# Frontend data source mode ("fixture_preview" | "live_backend")
# Defaults to "fixture_preview" until Phase 7B/7C API routes are connected.
NEXT_PUBLIC_DATA_SOURCE_MODE="fixture_preview"

# Public API base URL for backend route handlers (used by client-side mutations).
# Set this on the hosted deployment so the frontend reaches the correct API host.
NEXT_PUBLIC_API_BASE_URL=""

# Feature flag: enable work order status-transition controls (Start / Complete).
# When "true", the Maintenance Activity panel renders Start Work Order and
# Complete / Mark Finished buttons for users with the work_order:transition permission.
NEXT_PUBLIC_WORK_ORDER_TRANSITIONS_ENABLED="false"
